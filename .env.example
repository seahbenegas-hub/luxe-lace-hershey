# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=generate-a-long-random-secret
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=use-a-strong-password

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# Google OAuth (get from https://console.cloud.google.com/)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Email and scheduled rental automations
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Luxe Lace <bookings@your-domain.com>
# Optional no-domain alternative: verify your Gmail address in Brevo first
BREVO_API_KEY=your-brevo-api-key
CRON_SECRET=generate-a-long-random-cron-secret